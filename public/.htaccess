# Apache Configuration for kingsley.my.id on DomaiNesia
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Direct installer script routes
RewriteRule ^win/?$ install.ps1 [L]
RewriteRule ^mac/?$ install.sh [L]

# Direct binary download shortcuts
RewriteRule ^download/win/?$ https://github.com/alfarezeljopalino1-source/Kingsley/releases/download/v1.0.1/Kingsley.Setup.1.0.1.exe [R=302,L]
RewriteRule ^download/mac/?$ https://github.com/alfarezeljopalino1-source/Kingsley/releases/download/v1.0.1/Kingsley-1.0.1-arm64.dmg [R=302,L]

# Proper MIME types for terminal scripts
<Files "install.ps1">
    ForceType text/plain
    Header set Content-Type "text/plain; charset=utf-8"
</Files>

<Files "install.sh">
    ForceType text/plain
    Header set Content-Type "text/plain; charset=utf-8"
</Files>

# Single Page Application (SPA) routing fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
